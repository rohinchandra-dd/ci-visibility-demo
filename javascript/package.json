{
  "name": "pulse-community-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "test": "jest --verbose --watchman=false",
    "test:fast": "jest --verbose --watchman=false --testPathPattern=unit",
    "test:integration": "jest --verbose --watchman=false --testPathPattern=integration",
    "test:slow": "jest --verbose --watchman=false --testPathPattern=slow",
    "test:flaky": "jest --verbose --watchman=false --testPathPattern=flaky",
    "test:e2e": "playwright test",
    "test:all": "jest --verbose --watchman=false --testPathPattern='unit|integration|slow|flaky'"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dd-trace": "^5.111.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "vite": "^6.0.3"
  }
}
